# Local Docker database:
DATABASE_URL="postgresql://postgres:password@localhost:5432/hotel_mini?schema=public"

# Public URL of the deployed app. Keep http://localhost:3000 for local development.
NEXTAUTH_URL="http://localhost:3000"

# Generate a unique value for each environment with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
